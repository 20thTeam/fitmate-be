# 운영 서버 환경 변수 예시. 서버의 deploy/ 폴더에 .env로 복사해 실제 값을 채운다.
# .env는 깃에 올리지 않는다(.gitignore).

# HTTPS 주소에 쓸 도메인. 도메인이 없으면 EC2 고정 IP로 sslip.io 주소를 쓴다.
# 예) 고정 IP가 3.35.10.20이면 3-35-10-20.sslip.io
DOMAIN=3-35-10-20.sslip.io

# RDS PostgreSQL 접속 정보
DB_URL=jdbc:postgresql://<RDS 엔드포인트>:5432/fitmate
DB_USERNAME=fitmate
DB_PASSWORD=<비밀번호>

# 요청을 허용할 프론트 주소 (쉼표 구분)
CORS_ALLOWED_ORIGINS=https://fitmate-fe.vercel.app,http://localhost:5173,http://localhost:3000

# 운영 화면(/admin) API 키. 프론트 코드·환경 변수에 넣지 않고 운영자가 화면에 직접 입력한다.
# 비워 두면 운영 API가 꺼진다. 길고 추측하기 어려운 값으로 정한다. 예) openssl rand -hex 24
ADMIN_KEY=<운영 키>
